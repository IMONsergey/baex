{
  "name": "baex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:media && vite",
    "build": "npm run prepare:media && tsc -b && vite build && node scripts/emit-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify:assets": "python3 scripts/sync-reference-assets.py --verify-only",
    "verify:content": "node scripts/verify-content.mjs",
    "check": "npm run prepare:media && npm run typecheck && npm run verify:content && npm run verify:assets",
    "postinstall": "npm run prepare:media",
    "prepare:media": "node scripts/prepare-media.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
